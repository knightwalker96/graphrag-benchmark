# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Generator: Gemini 2.5 Flash answers the questions ---
GOOGLE_API_KEY=your-google-api-key-here
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# --- Judge: a different model family, to avoid a model grading itself ---
OPENAI_API_KEY=your-openai-api-key-here
JUDGE_MODEL=gpt-4o-mini
JUDGE_PROVIDER=openai

# --- TigerGraph Savanna: graph database + vector store for Pipeline 3 ---
TIGERGRAPH_HOST=https://your-instance.i.tgcloud.io
TIGERGRAPH_USERNAME=your-username
TIGERGRAPH_PASSWORD=your-password
TIGERGRAPH_SECRET=your-secret
TIGERGRAPH_GRAPH=finance

# --- Shared retrieval settings (defaults shown; both P2 and P3 use the same embedder) ---
DATASET=sec
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CONTEXT_NUM_CHUNKS=10
CONTEXT_CHUNK_CHARS=2000
